{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-imap": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-zlib": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "chartblocks/php-ssrs": "^1.0",
        "clue/http-proxy-react": "^1.9",
        "davmixcool/php-sentiment-analyzer": "^1.2",
        "echolabsdev/prism": "^0.34.0",
        "facebook/php-business-sdk": "^21.0",
        "infobip/infobip-api-php-client": "^6.2",
        "james-heinrich/getid3": "^1.9",
        "jeremykendall/php-domain-parser": "6.0",
        "kevinrob/guzzle-cache-middleware": "^6.0",
        "laravel/framework": "^11.32",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "*",
        "php-imap/php-imap": "^5.0",
        "phpoffice/phppresentation": "^1.1",
        "phpoffice/phpspreadsheet": "^1.29",
        "phpoffice/phpword": "^1.4",
        "roach-php/core": "^3.2",
        "roach-php/laravel": "^3.1",
        "shuchkin/simplexlsxgen": "^1.4",
        "spatie/browsershot": "^5.0",
        "spatie/icalendar-generator": "^2.9",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-permission": "^6.9",
        "yajra/laravel-datatables": "^11.0",
        "yajra/laravel-datatables-html": "11.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "barryvdh/laravel-debugbar": "^3.15",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
