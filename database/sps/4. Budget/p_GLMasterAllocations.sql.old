CREATE  or alter  PROCEDURE p_GetBudgetWorkspace

    @budgetId INT,

    @branchId INT

    AS

BEGIN

    SET NOCOUNT ON;

    -- Step 1: Create temp table with full columns

CREATE TABLE #TempBudgetWorkspace (

                                      Id INT,

                                      BudgetID INT,

                                      BranchID INT

    ,

                                      GLAttachmentID NVARCHAR(50),

                                      AccountID NVARCHAR(50),

                                      Type NVARCHAR(50),

                                      Description NVARCHAR(255),

                                      GLAccountTypeID NVARCHAR(10),

                                      Month1 DECIMAL(18, 2),

                                      Month2 DECIMAL(18, 2),

                                      Month3 DECIMAL(18, 2),

                                      Month4 DECIMAL(18, 2),

                                      Month5 DECIMAL(18, 2),

                                      Month6 DECIMAL(18, 2),

                                      Month7 DECIMAL(18, 2),

                                      Month8 DECIMAL(18, 2),

                                      Month9 DECIMAL(18, 2),

                                      Month10 DECIMAL(18, 2),

                                      Month11 DECIMAL(18, 2),

                                      Month12 DECIMAL(18, 2),

                                      Totals DECIMAL(18, 2),

                                      Actuals DECIMAL(18, 2),

                                      PercentageChange DECIMAL(18, 2)

);

-- Step 2: Populate the temp table

INSERT INTO #TempBudgetWorkspace (

    Id, BudgetID, BranchID, GLAttachmentID, AccountID, Type, Description, GLAccountTypeID,

    Month1, Month2, Month3, Month4, Month5, Month6,

    Month7, Month8, Month9, Month10, Month11, Month12,

    Totals, Actuals, PercentageChange

)

SELECT

    Id,

    BudgetID,

    BranchID,

    GLAttachmentID,

    A.AccountID,

    Type,

    Description,

    GLAccountTypeID,

    Month1, Month2, Month3, Month4, Month5, Month6,

    Month7, Month8, Month9, Month10, Month11, Month12,

    ISNULL(Month1,0) + ISNULL(Month2,0) + ISNULL(Month3,0) + ISNULL(Month4,0) + ISNULL(Month5,0) + ISNULL(Month6,0) +

    ISNULL(Month7,0) + ISNULL(Month8,0) + ISNULL(Month9,0) + ISNULL(Month10,0) + ISNULL(Month11,0) + ISNULL(Month12,0) AS Totals,

    0 AS Actuals,  -- Placeholder: update this in next step

    0 AS PercentageChange  -- Placeholder: update this in next step

FROM t_BudgetGLMasterAllocations A


WHERE BudgetID = @budgetId AND BranchID = @branchId;



UPDATE r

SET r.Actuals =G.Localbalance

    FROM #TempBudgetWorkspace r

    JOIN t_GLBranch G WITH (NOLOCK) ON r.AccountID = G.AccountID;

--Step 3 Calculate the percentage change

UPDATE #TempBudgetWorkspace

SET PercentageChange = CASE

                           WHEN Actuals = 0 THEN NULL

                           ELSE (Totals / Actuals) * 100

    END;

-- Step 4: Return the data

SELECT * FROM #TempBudgetWorkspace;

END;

