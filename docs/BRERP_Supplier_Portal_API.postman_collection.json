              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rfqId\": 20,\n  \"currency\": \"KES\",\n  \"durationDays\": 14,\n  \"leadTimeDays\": 7,\n  \"items\": [\n    {\n      \"rfqLineId\": 45,\n      \"quotedPrice\": 85000.00,\n      \"totalPayable\": 850000.00,\n      \"comments\": \"Brand new, with warranty\"\n    }\n  ],\n  \"isDraft\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/procurement/rfq-responses",
              "host": ["{{base_url}}"],
              "path": ["procurement", "rfq-responses"]
            },
            "description": "Submit RFQ response with pricing for all line items"
