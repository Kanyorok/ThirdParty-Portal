                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rfqId\": 20,\n  \"question\": \"Can we substitute with an equivalent brand?\",\n  \"rfqLineId\": 45\n}"
            },
            "url": {
              "raw": "{{base_url}}/procurement/rfq-clarifications",
              "host": ["{{base_url}}"],
              "path": ["procurement", "rfq-clarifications"]
            },
            "description": "Submit a clarification question for an RFQ"
          },
          "response": []
        }
      ]
    },
