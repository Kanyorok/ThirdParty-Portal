              }
            ],
            "url": {
              "raw": "{{base_url}}/procurement/rfq-suppliers",
              "host": ["{{base_url}}"],
              "path": ["procurement", "rfq-suppliers"]
            },
            "description": "Get all RFQ invitations for authenticated supplier"
          },
          "response": []
        },
        {
          "name": "Get RFQ Details",
