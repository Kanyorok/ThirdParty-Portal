# Frontend Environment Variables
# Copy this file to .env and update with your server details

# External API URL (Backend)
EXTERNAL_API_URL=http://YOUR_SERVER_IP:8000
NEXT_PUBLIC_EXTERNAL_API_URL=http://YOUR_SERVER_IP:8000
API_BASE_URL=http://YOUR_SERVER_IP:8000

# Next-Auth Configuration
NEXTAUTH_SECRET="CQd3zbQhL85L95nDa6aBGTQGGPqbuPSzO66xPxwNlEM="
NEXTAUTH_URL="http://YOUR_SERVER_IP:3001"

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=YOUR_SERVER_IP:3001,YOUR_SERVER_IP

# Environment
NODE_ENV="production"

# Cache Version
COUNTRIES_CACHE_VERSION=2

# Example for server 172.16.2.16:
# EXTERNAL_API_URL=http://172.16.2.16:8000
# NEXT_PUBLIC_EXTERNAL_API_URL=http://172.16.2.16:8000
# API_BASE_URL=http://172.16.2.16:8000
# NEXTAUTH_URL="http://172.16.2.16:3001"
# SANCTUM_STATEFUL_DOMAINS=172.16.2.16:3001,172.16.2.16
